{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/relay/Dockerfile",
    "watchPatterns": [
      "packages/relay/**",
      "packages/shared/**",
      "deploy/relay/Dockerfile",
      "railway.json",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "tsconfig.json",
      ".npmrc",
      ".dockerignore"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "sleepApplication": false,
    "healthcheckPath": "/readyz",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "overlapSeconds": 0,
    "drainingSeconds": 15
  }
}
