# Avalanche Fuji Testnet RPC
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Deployer / Admin private key (NEVER commit the real value)
DEPLOYER_PRIVATE_KEY=0x_your_deployer_private_key_here

# Relay Signer private key (co-signs 2-of-3 match results)
RELAY_PRIVATE_KEY=0x_your_relay_signer_private_key_here

# Arbiter private key (resolves disputed challenges)
ARBITER_PRIVATE_KEY=0x_your_arbiter_private_key_here

# Relay server configuration
PORT=8080
CHESS_ESCROW_ADDRESS=0x_deployed_contract_address
CHAIN_ID=43113

# Web app
NEXT_PUBLIC_RELAY_URL=ws://localhost:8080
NEXT_PUBLIC_CHAIN_ID=43113
NEXT_PUBLIC_CONTRACT_ADDRESS=0x_deployed_contract_address
