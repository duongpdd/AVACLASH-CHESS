# Avalanche Fuji Testnet RPC
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Deployment Configuration (Deploy.s.sol)
# Required distinct addresses (never zero address, never identical)
RELAY_SIGNER_ADDRESS=0x_your_relay_signer_public_address_here
ARBITER_ADDRESS=0x_your_arbiter_public_address_here
TREASURY_ADDRESS=0x_your_treasury_public_address_here

# Security Notice: Deploy using Foundry Keystore (--account), do NOT store naked private keys in .env
# 1. Import keystore: cast wallet import avaclash-deployer --interactive
# 2. From contracts/: forge script script/Deploy.s.sol:DeployScript --rpc-url $FUJI_RPC_URL --account avaclash-deployer --broadcast

# Relay Server private key (off-chain daemon for co-signing 2-of-3 match results)
RELAY_PRIVATE_KEY=0x_your_relay_signer_private_key_here

# Relay server configuration
PORT=8080
ESCROW_ADDRESS=0x_deployed_contract_address
CHAIN_ID=43113
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOW_NO_ORIGIN=false
TRUST_PROXY=false
SIGNAL_GAME_STARTED_ENABLED=true
RELAY_MIN_BALANCE=0.1
RESULTS_DIR=./results

# Web app
NEXT_PUBLIC_RELAY_URL=ws://localhost:8080
NEXT_PUBLIC_CHAIN_ID=43113
NEXT_PUBLIC_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
NEXT_PUBLIC_ESCROW_ADDRESS=0x_deployed_contract_address
NEXT_PUBLIC_META_ADDRESS=0x_deployed_meta_address
NEXT_PUBLIC_UI_MAX_STAKE=0.1
