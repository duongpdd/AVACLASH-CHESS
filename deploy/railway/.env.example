# Import into Railway Variables, not Vercel. Fill the actual web origin.
HOST=0.0.0.0
PORT=8080
CHAIN_ID=43113
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
ESCROW_ADDRESS=0x638135fA831A000DD438c6F6EFa7e75BC36aC78F
RELAY_PRIVATE_KEY=
ALLOWED_ORIGINS=
ALLOW_NO_ORIGIN=false
# Only expose the service through Railway's public HTTP edge, not a TCP proxy.
TRUST_PROXY=true
SIGNAL_GAME_STARTED_ENABLED=true
RELAY_MIN_BALANCE=0.1
RESULTS_DIR=/data/results
ACTIVE_DIR=/data/results/active
# Railway mounts volumes as root; this overrides the image's USER node.
RAILWAY_RUN_UID=0
# Add a volume at /data in Railway. Do not manually set RAILWAY_VOLUME_MOUNT_PATH.
