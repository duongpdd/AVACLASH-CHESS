# Public configuration only. Copy to .env.fuji.local and fill addresses.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
DEPLOYER_ADDRESS=0x0000000000000000000000000000000000000000
RELAY_SIGNER_ADDRESS=0x0000000000000000000000000000000000000000
ARBITER_ADDRESS=0x0000000000000000000000000000000000000000
TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# Fill these after contract deployment; use the stable Vercel production origin.
NEXT_PUBLIC_CHAIN_ID=43113
NEXT_PUBLIC_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
NEXT_PUBLIC_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_META_ADDRESS=0x0000000000000000000000000000000000000000
# Add the TournamentPrizePool address to activate the Cup on web and relay.
NEXT_PUBLIC_TOURNAMENT_ADDRESS=
NEXT_PUBLIC_RELAY_URL=wss://relay.example.com
NEXT_PUBLIC_UI_MAX_STAKE=0.1
WEB_ORIGIN=https://avaclash.vercel.app
