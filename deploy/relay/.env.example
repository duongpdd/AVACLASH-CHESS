# Copy generated .local/deploy/relay.env here as .env after Fuji deployment.
RELAY_DOMAIN=relay.example.com
HOST=0.0.0.0
PORT=8080
CHAIN_ID=43113
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
# Set on the relay host only; must match the on-chain relaySigner.
RELAY_PRIVATE_KEY=
ALLOWED_ORIGINS=https://avaclash.vercel.app
ALLOW_NO_ORIGIN=false
TRUST_PROXY=true
SIGNAL_GAME_STARTED_ENABLED=true
RELAY_MIN_BALANCE=0.1
RESULTS_DIR=/data/results
ACTIVE_DIR=/data/results/active
