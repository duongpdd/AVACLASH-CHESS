# AvaClash Web Frontend Environment Configuration
# Target Chain ID: 43113 (Avalanche Fuji Testnet) or 31337 (Local Anvil)
NEXT_PUBLIC_CHAIN_ID=43113

# RPC endpoint (Avalanche Fuji or Local Anvil)
NEXT_PUBLIC_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Contract Addresses (Placeholder 0x0; MUST configure with deployed contract address before use)
NEXT_PUBLIC_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_META_ADDRESS=0x0000000000000000000000000000000000000000

# Relay Server WebSocket URL (Turn 2c / 3b)
NEXT_PUBLIC_RELAY_URL=ws://localhost:8080

# UI Maximum Stake Limit (AVAX) - defaults to 0.1 AVAX for safety
NEXT_PUBLIC_UI_MAX_STAKE=0.1

# Tùy chọn cho Bộ sưu tập và Chợ testnet. Cần cấu hình cả hai địa chỉ.
NEXT_PUBLIC_COSMETICS_ADDRESS=
NEXT_PUBLIC_AUCTION_ADDRESS=
